{
  "functions": {
    "api/sitemap.ts": {
      "maxDuration": 30
    },
    "api/social-metrics.ts": {
      "maxDuration": 10
    },
    "api/admin.ts": {
      "maxDuration": 30,
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemaps/:file",
      "destination": "/api/sitemap?file=:file"
    },
    {
      "source": "/admin",
      "destination": "/api/admin?resource=page"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin?resource=missing"
    },
    {
      "source": "/((?!api/|assets/|sitemaps/|sitemap\\.xml$|robots\\.txt$|favicon|google[^/]*\\.html$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path(estudio|biblioteca|perfil|definicoes|notificacoes|moderacao|sistema|entrar|registar|recuperar-senha|redefinir-senha|confirmar-email|boas-vindas|auth)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
