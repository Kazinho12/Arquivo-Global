# Variáveis de ambiente públicas para o Arquivo Global
# Substituir pelos valores do teu projeto Supabase em .env.local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_replace_me

# Ativar apenas após instalar e validar 20261111040000_persist_cover_styles.sql
VITE_ENABLE_COVER_STYLE=false

# Ativar só após validar 20261111050000_cover_studio_v2.sql (requer COVER_STYLE=true)
VITE_ENABLE_COVER_STUDIO_V2=false

# F4.2-A: só após validar a migration custom_cover_media e o Worker existente
VITE_ENABLE_CUSTOM_COVERS=false

# F4.2-B: apenas após validar a migration visual_editor_private e o Worker
VITE_ENABLE_VISUAL_EDITOR=false

# F4.2-C: apenas após migration, Worker público e validação dos snapshots
VITE_ENABLE_PUBLIC_VISUAL_READER=false

# F5.1 — enable only after the local social migration is installed and tested.
VITE_ENABLE_SOCIAL=false
# Server-only Vercel secret; never prefix this name with VITE_. Configure its SHA-256 in social_metric_settings.
SOCIAL_METRICS_SECRET=

# F5.3: enable only after reading_library migration and private-account validation.
VITE_ENABLE_READING_SYNC=false
